# cmake -DROOT=<ps2xRecomp> -DRUNTIME_INCLUDE=<runtime/include> -DBUILT_WITH=<compiler, system> -DOUT=<header> -P source_id.cmake
#
# The recompiler's source id, for the output manifest (include/ps2recomp/output_manifest.h): the SHA-256 of its
# CMakeLists.txt (which pins the fetched libraries' versions), every file under src/ and include/, and the runtime
# headers those include ("ps2_runtime_calls.h" and what it includes in turn), each by its name relative to ROOT or
# RUNTIME_INCLUDE and its text with CRLF read as LF (a Windows checkout's sources are the Mac's). Run at every build;
# OUT is rewritten only when the id changed, so nothing is compiled again otherwise.
cmake_minimum_required(VERSION 3.20)   # (a -P script's policies are otherwise the oldest: IN_LIST)
file(GLOB_RECURSE own LIST_DIRECTORIES false RELATIVE "${ROOT}" "${ROOT}/src/*" "${ROOT}/include/*")
list(APPEND own "CMakeLists.txt")
set(files "")
foreach(f IN LISTS own)
    list(APPEND files "${ROOT}/${f}")
endforeach()
# The runtime headers the sources include, followed through the headers they include.
set(queue ${files})
set(runtime "")
while(queue)
    list(POP_FRONT queue f)
    if(NOT f MATCHES "\\.(h|hpp|inc|cpp)$")
        continue()
    endif()
    file(STRINGS "${f}" lines REGEX "^[ \t]*#[ \t]*include[ \t]*\"")
    foreach(line IN LISTS lines)
        if(line MATCHES "\"([^\"]+)\"")
            set(candidate "${RUNTIME_INCLUDE}/${CMAKE_MATCH_1}")
            if(EXISTS "${candidate}" AND NOT IS_DIRECTORY "${candidate}")
                file(REAL_PATH "${candidate}" candidate)
                if(NOT candidate IN_LIST runtime)
                    list(APPEND runtime "${candidate}")
                    list(APPEND queue "${candidate}")
                endif()
            endif()
        endif()
    endforeach()
endwhile()
file(REAL_PATH "${RUNTIME_INCLUDE}" runtimeRoot)
set(listing "")
foreach(f IN LISTS files runtime)
    file(READ "${f}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(SHA256 h "${text}")
    file(RELATIVE_PATH name "${ROOT}" "${f}")
    if(f IN_LIST runtime)
        file(RELATIVE_PATH name "${runtimeRoot}" "${f}")
        set(name "runtime/include/${name}")
    endif()
    list(APPEND listing "${name} ${h}")
endforeach()
list(SORT listing)
list(JOIN listing "\n" listing)
string(SHA256 id "${listing}\n")
string(SUBSTRING "${id}" 0 16 id)
set(header "// Made by cmake/source_id.cmake at build time: do not edit.\n#define PS2RECOMP_SOURCE_ID \"src-${id}\"\n#define PS2RECOMP_BUILT_WITH \"${BUILT_WITH}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL header)
    file(WRITE "${OUT}" "${header}")
endif()
