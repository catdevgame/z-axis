gametitle=Aggressive Inline (USA) (SLUS-20327)

// Mods for the original game, from the research behind the Aggressive Inline native
// PC port. Each [section] is one mod: turn it on in PCSX2 under Game Properties >
// Patches. See README.md next to this file. Generated by tools/build_mods_pnach.py
// from tools/ai_mods_pnach.s; do not edit by hand.
//
// Shared code lives in libkernl's unused file-system functions (0x00219A80-0x0021B5B7)
// and shared variables in the .rodata padding 0x002728C0-0x002728DB. Sections that
// share a hook write identical words there, so any combination can be on, except
// two Widescreen sections, two values of the same setting (e.g. Camera Distance
// 150% and 200%), Juice Regeneration with Juice Drain 50% / No Juice Drain, and
// Invulnerability with Juice Lost on Crash 50% (they write the same value).

[Widescreen 16:9 (HUD fix)]
author=BloodRaynare (based on ElHecht's PAL patch); HUD/2D fix and aspect variants: Aggressive Inline PC port
description=16:9 3D with the HUD at the screen edges and in-game 2D (menus, text boxes) kept in shape; the front end and movies show as 4:3 between bars. Use instead of the built-in Widescreen 16:9 patch, and turn on only one widescreen section. (tested in PCSX2)
gsaspectratio=16:9
// 3D: BloodRaynare's patch (horizontal scale 0.7500, view frustum widened by the same)
patch=1,EE,00101130,word,3C013F40 // lui at,0x3F40: horizontal scale 0.7500, was 3C013F80 (lui at,0x3f80)
patch=1,EE,00272894,word,3C093F40 // frustum code cave: lui t1,0x3F40 (rodata padding, was 0)
patch=1,EE,00101714,word,0809CA25 // j 0x00272894, was 46000843 (div.s f1,f1,f0)
patch=1,EE,00101718,word,00000000 // was E62004E8 (swc1 f0,0x4E8(s1))
patch=1,EE,0027289C,word,4489F000 // mtc1 t1,f30
patch=1,EE,002728A0,word,461E0843 // div.s f1,f1,f30: half width / scale
patch=1,EE,002728A4,word,46000843 // div.s f1,f1,f0 (the replaced instruction)
patch=1,EE,002728A8,word,E62004E8 // swc1 f0,0x4E8(s1) (the replaced instruction)
patch=1,EE,002728AC,word,080405C6 // j 0x00101718
// 2D and HUD (Aggressive Inline PC port): squeeze 2D by the scale, move HUD widgets out by width * shift
patch=1,EE,002728D4,word,3F400000 // squeeze scale 0.750000
patch=1,EE,002728D8,word,3E2AAAAB // HUD shift 0.166667 of the width
