[Widescreen 21:9 (HUD fix)]
author=BloodRaynare (based on ElHecht's PAL patch); HUD/2D fix and aspect variants: Aggressive Inline PC port
description=21:9 (2.33:1) 3D with the HUD at the screen edges and in-game 2D (menus, text boxes) kept in shape; the front end and movies show as 4:3 between bars. Use instead of the built-in Widescreen 16:9 patch, and turn on only one widescreen section. (tested in PCSX2)
// PCSX2 has no 21:9 output setting: set Aspect Ratio to Stretch and use a 21:9 window or screen.
// 3D: BloodRaynare's patch (horizontal scale 0.5703, view frustum widened by the same)
patch=1,EE,00101130,word,3C013F12 // lui at,0x3F12: horizontal scale 0.5703, was 3C013F80 (lui at,0x3f80)
patch=1,EE,00272894,word,3C093F12 // frustum code cave: lui t1,0x3F12 (rodata padding, was 0)
patch=1,EE,00101714,word,0809CA25 // j 0x00272894, was 46000843 (div.s f1,f1,f0)
patch=1,EE,00101718,word,00000000 // was E62004E8 (swc1 f0,0x4E8(s1))
patch=1,EE,0027289C,word,4489F000 // mtc1 t1,f30
patch=1,EE,002728A0,word,461E0843 // div.s f1,f1,f30: half width / scale
patch=1,EE,002728A4,word,46000843 // div.s f1,f1,f0 (the replaced instruction)
patch=1,EE,002728A8,word,E62004E8 // swc1 f0,0x4E8(s1) (the replaced instruction)
patch=1,EE,002728AC,word,080405C6 // j 0x00101718
// 2D and HUD (Aggressive Inline PC port): squeeze 2D by the scale, move HUD widgets out by width * shift
patch=1,EE,002728D4,word,3F120000 // squeeze scale 0.570312
patch=1,EE,002728D8,word,3EC0E070 // HUD shift 0.376712 of the width
