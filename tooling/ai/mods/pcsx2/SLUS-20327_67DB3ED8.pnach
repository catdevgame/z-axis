patch=1,EE,00249FC8,word,00000000 // Manual Balance Init = 0 (game: 0.01); as the game's cheat code sets it (0x001AA628)

[Cheat: Super Spin]
author=Aggressive Inline PC port
description=Spins twice as fast in the air. The game's own cheat, always on, without its code (and without setting the cheat bits the codes leave in the career data). (partly tested: value checked in PCSX2 memory, effect not played)
patch=1,EE,002473B8,word,44200000 // Air Rotate = 640 (game: 320); as the game's cheat code sets it (0x001AA628)

[Unlock Everything]
author=Aggressive Inline PC port
description=All levels, skaters, park editor pieces and Media Viewer cutscenes. Writes the career data: saving the career keeps the unlocks after the patch is turned off. (tested in PCSX2)
// Unlock bits of the career data at 0x0024CBB8 (64-bit), ORed so other progress is kept
patch=1,EE,7024CBB8,extended,0010FFFF // 16-bit OR 0xFFFF: bits 0-15 (levels, skaters, park pieces)
patch=1,EE,7024CBBA,extended,0000000F // 8-bit OR 0x0F: bits 16-19
patch=1,EE,7024CBBE,extended,0000007F // 8-bit OR 0x7F: bits 48-54 (Media Viewer cutscenes)
// The 20 skater records at 0x0024DB30 + n * 0x510: +1 = 10, +4 = all levels (as the game's codes)
patch=1,EE,0024DB31,extended,0000000A // skater 0: 8-bit write 10
patch=1,EE,0024DB34,word,FFFFFFFF // skater 0: level mask
patch=1,EE,0024E041,extended,0000000A // skater 1: 8-bit write 10
patch=1,EE,0024E044,word,FFFFFFFF // skater 1: level mask
