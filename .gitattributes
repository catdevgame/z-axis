# The licence texts every package ships, checked out byte for byte on every platform: build-ffmpeg.sh compares
# FFmpeg's own COPYING.LGPLv2.1 with its copy here, and release.sh each package's LICENSE, NOTICE and FFmpeg licence
# with the tree's, which a Windows checkout's autocrlf made CRLF
LICENSE -text
NOTICE -text
third_party/licenses/** -text
# The other text files the Windows zip carries, for the same reason (tools/checks/release_check.py TREE_TEXT: 1.3.1's
# had a CRLF Michroma-OFL.txt): the font's licence and the README's template (make-windows.ps1 ends its lines CRLF)
collection/resources/fonts/*.txt -text
platform/windows/README.txt -text
